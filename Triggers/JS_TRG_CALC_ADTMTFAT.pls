CREATE OR REPLACE TRIGGER JS_TRG_CALC_ADTMTFAT
BEFORE INSERT OR UPDATE OF DTINI, DTFIN, FATGERALMETA, FATGERALCRESC ON AD_TMTFAT 
FOR EACH ROW
BEGIN
     IF :NEW.CODMETA IS NULL THEN 
        RAISE_APPLICATION_ERROR(-20001,'<b>Código da Meta:</b> Código da Meta não identificado no contexto atual.');
    END IF;

    IF :NEW.DTINI IS NULL OR :NEW.DTFIN IS NULL OR :NEW.DTINI > :NEW.DTFIN THEN 
        RAISE_APPLICATION_ERROR(-20002,'<b>Intervalos de Faturamento:</b> Datas de inicio e fim de faturamento não preenchidas corretamente no cabeçalho.');
    END IF;

    IF :NEW.CODEMP IS NULL THEN 
        RAISE_APPLICATION_ERROR(-20003,'<b>Código da Empresa:</b> Código da Empresa não Preenchido.');
    END IF;

    PKG_METAS_FATURAMENTO.RESET_PKG;

    IF INSERTING OR (:NEW.DTINI != :OLD.DTINI) OR (:NEW.DTFIN != :OLD.DTFIN) THEN 
        PKG_METAS_FATURAMENTO.VG_UPDATING_CAB:= TRUE; --Flag de controle
        :NEW.FATGERAL:= JS_FC_CALC_FAT(P_DTINI => :NEW.DTINI, P_DTFIN => :NEW.DTFIN, P_CODEMP => :NEW.CODEMP);

        IF INSERTING AND :NEW.DTREF IS NULL THEN 
            :NEW.DTREF:= ADD_MONTHS(TRUNC(SYSDATE,'MM'),0);
        END IF;
    ELSE 
        :NEW.FATGERAL:= COALESCE(:NEW.FATGERAL, 0);
    END IF;

    IF UPDATING AND (COALESCE(:NEW.FATGERALMETA, 0) != COALESCE(:OLD.FATGERALMETA, 0) OR COALESCE(:NEW.FATGERALCRESC, 0) != COALESCE(:OLD.FATGERALCRESC, 0)) THEN
            IF COALESCE(:NEW.FATGERALMETA, 0) = 0 THEN 
                :NEW.FATGERALMETA:= COALESCE(:NEW.FATGERAL, 0) * (1 + COALESCE(:NEW.FATGERALCRESC, 0) / 100);
            ELSE
                :NEW.FATGERALMETA:= COALESCE(:NEW.FATGERALMETA, 0) * (1 + COALESCE(:NEW.FATGERALCRESC, 0) / 100);
            END IF; 
    ELSE
        :NEW.FATGERALMETA:= COALESCE(:NEW.FATGERAL, 0) * (1 + COALESCE(:NEW.FATGERALCRESC, 0) / 100);
    END IF;

    :NEW.AVGERAL:= COALESCE(:NEW.FATGERALMETA, 0) * COALESCE(:NEW.AVGERALPERC, 2) /100;

    -- Gravando valores na PGA (Alternativa para evitar tabela mutante) 
    PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).DTINI:= :NEW.DTINI;
    PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).DTFIN:= :NEW.DTFIN;
    PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).FATGERAL:= :NEW.FATGERAL;
    PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).FATGERALMETA:= :NEW.FATGERALMETA;
    PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).CODEMP:= :NEW.CODEMP;
    PKG_METAS_FATURAMENTO.VG_READ_PKG:= TRUE; --Flag de controle

    IF UPDATING THEN 
        --Produtos da meta
        UPDATE AD_TMTFATRTPRO SET CODMETA = CODMETA
        WHERE CODMETA = :NEW.CODMETA;

        --Vendedores da meta
        UPDATE AD_TMTFATRTVEN SET CODMETA = CODMETA
        WHERE CODMETA = :NEW.CODMETA;

        --Alterações do usuário
        :NEW.CODUSU:= TSIUSU_LOG_PKG.V_CODUSULOG;
        :NEW.DHALTER:= SYSDATE;
    END IF;

    PKG_METAS_FATURAMENTO.RESET_PKG;
EXCEPTION 
    WHEN OTHERS THEN 
        RAISE_APPLICATION_ERROR(-20004,'Não foi possível calcular métricas do Cabeçalho da Meta.' || SQLERRM);
END;
