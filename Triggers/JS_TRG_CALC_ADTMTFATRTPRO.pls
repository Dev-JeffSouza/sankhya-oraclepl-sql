CREATE OR REPLACE TRIGGER JS_TRG_CALC_ADTMTFATRTPRO
BEFORE INSERT OR UPDATE ON AD_TMTFATRTPRO
FOR EACH ROW
DECLARE 
    V_MSG VARCHAR2(4000);
    V_DTINI          AD_TMTFAT.DTINI%TYPE;           
    V_DTFIN          AD_TMTFAT.DTFIN%TYPE;           
    V_FATGERALANT    AD_TMTFAT.FATGERAL%TYPE;       
    V_FATGERALMETA   AD_TMTFAT.FATGERALMETA%TYPE;  
    V_CODEMP         AD_TMTFAT.CODEMP%TYPE;
    V_PTCPROD        AD_TMTFATRTVENPRO.PTCVENPRO%TYPE;
    CSDEC            NUMBER;
    V_CODUSU         NUMBER;
    V_SUMFAT         NUMBER;
BEGIN 

    IF :NEW.CODMETA IS NULL THEN 
        RAISE_APPLICATION_ERROR(-20001,'<b>Código da Meta</b>. Código da Meta não identificado no contexto atual.');
    END IF;

    IF :NEW.CODPROD IS NULL THEN 
        RAISE_APPLICATION_ERROR(-20002,'<b>Código do Produto</b>. Preencha o Código do Produto.');
    END IF;

    CSDEC:= COALESCE(GET_TSIPAR_INTEIRO('CSDEC'), 2);

    IF PKG_METAS_FATURAMENTO.VG_READ_PKG AND PKG_METAS_FATURAMENTO.V_ARR_CAB.EXISTS(:NEW.CODMETA) THEN 
        V_DTINI:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).DTINI;
        V_DTFIN:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).DTFIN;
        V_CODEMP:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).CODEMP;
        V_FATGERALMETA:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).FATGERALMETA;
        V_FATGERALANT:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).FATGERAL;
    ELSE 
        BEGIN
            SELECT DTINI, DTFIN, FATGERALMETA, FATGERAL, CODEMP
            INTO V_DTINI, V_DTFIN, V_FATGERALMETA, V_FATGERALANT, V_CODEMP
            FROM AD_TMTFAT 
            WHERE CODMETA = :NEW.CODMETA;

            PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).DTINI:= V_DTINI;
            PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).DTFIN:= V_DTFIN;
            PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).CODEMP:= V_CODEMP;
            PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).FATGERALMETA:= V_FATGERALMETA;
            PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).FATGERAL:= V_FATGERALANT;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                V_DTINI:= TRUNC(ADD_MONTHS(SYSDATE, -1), 'MM');
                V_DTFIN:= TRUNC(LAST_DAY(ADD_MONTHS(SYSDATE, -1)));
                V_FATGERALMETA:= 0;
                V_FATGERALANT:= 0;
                V_CODEMP:= COALESCE(GET_TSIPAR_INTEIRO('DEFAULTEMP'), 1);
        END;
    END IF;

    IF INSERTING OR (:NEW.CODPROD != :OLD.CODPROD) OR PKG_METAS_FATURAMENTO.VG_UPDATING_CAB THEN 
        :NEW.FATPROD := JS_FC_CALC_FAT(P_DTINI => V_DTINI, P_DTFIN => V_DTFIN, P_CODPROD => :NEW.CODPROD, P_CODEMP => V_CODEMP);
        :NEW.QTDNEG  := JS_FC_CALC_FAT(P_DTINI => V_DTINI, P_DTFIN => V_DTFIN, P_CODPROD => :NEW.CODPROD, P_CODEMP => V_CODEMP, P_ITENEG => 'S');
    ELSE
        :NEW.FATPROD := COALESCE(:NEW.FATPROD, 0);
        :NEW.QTDNEG  := COALESCE(:NEW.QTDNEG, 0);
    END IF;

    V_SUMFAT:= COALESCE(:NEW.FATPROD, 0) + COALESCE(:NEW.FATESTIPRO, 0); 
    V_PTCPROD:= COALESCE(COALESCE(:NEW.FATPROD, 0) / NULLIF(V_FATGERALANT, 0) *100, 0);
    :NEW.PTCPROD:= COALESCE(ROUND(V_PTCPROD, CSDEC), 0);
    :NEW.TCKAVG:= COALESCE(ROUND(COALESCE(:NEW.FATPROD, 0) / NULLIF(:NEW.QTDNEG, 0), CSDEC), 0);
    :NEW.PXMETA:= COALESCE(ROUND(COALESCE(V_FATGERALMETA, 0) * (V_PTCPROD/100) * (1+ COALESCE(:NEW.PTCPRODCRESC,0) /100) + COALESCE(:NEW.FATESTIPRO, 0), CSDEC), 0);
    :NEW.AVPROD:= COALESCE(:NEW.PXMETA, 0) * (COALESCE(:NEW.AVPRODPERC, 0) / 100);
    :NEW.VPERCPROD:= COALESCE(ROUND(COALESCE((:NEW.PXMETA - V_SUMFAT) / NULLIF(V_SUMFAT, 0) *100, 0), CSDEC), 0);
    :NEW.QTDNEGMETA:= COALESCE(ROUND(COALESCE(:NEW.PXMETA, 0) / NULLIF(:NEW.TCKAVG, 0)), 0);

    IF UPDATING AND NOT PKG_METAS_FATURAMENTO.VG_READ_PKG THEN
        UPDATE AD_TMTFAT SET 
            DHALTER = SYSDATE,
            CODUSU = TSIUSU_LOG_PKG.V_CODUSULOG
        WHERE CODMETA = :NEW.CODMETA;
    END IF;
EXCEPTION 
    WHEN OTHERS THEN 
        RAISE_APPLICATION_ERROR(-20003, '<b>Erro:</b> Não foi possível calcular o faturamento do Vendedor na meta.' || SQLERRM);
END;
