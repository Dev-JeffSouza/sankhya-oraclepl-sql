CREATE OR REPLACE TRIGGER JS_TRG_UPD_AD_TMTFAT
AFTER UPDATE OF DTINI, DTFIN, FATGERALMETA, CODEMP ON AD_TMTFAT
FOR EACH ROW
BEGIN
    IF (NVL(:NEW.DTINI, '01/01/1900') != NVL(:OLD.DTINI, '01/01/1900') 
        OR NVL(:NEW.DTFIN, '01/01/1900') != NVL(:OLD.DTFIN, '01/01/1900')
        OR NVL(:NEW.CODEMP, 0) != NVL(:OLD.CODEMP, 0))
    THEN
        -- << Chamadas em cascata para recalcular as grades >> --

        -- Resultado dos Produtos
        JS_STP_CALC_RES_PRO (P_DTINI => :NEW.DTINI, P_DTFIN => :NEW.DTFIN, P_CODMETA => :NEW.CODMETA, P_FATGERAL => :NEW.FATGERAL, P_FATGERALMETA => :NEW.FATGERALMETA, P_CODEMP => :NEW.CODEMP);
        -- Resultado dos Vendedores
        JS_STP_CALC_META_VEN (P_DTINI => :NEW.DTINI, P_DTFIN => :NEW.DTFIN, P_CODMETA => :NEW.CODMETA, P_FATGERAL => :NEW.FATGERAL, P_FATGERALMETA => :NEW.FATGERALMETA, P_CODEMP => :NEW.CODEMP);
        -- Resultado dos Vendedores/Parceiros
        JS_STP_CALC_RES_VEN_PCR (P_DTINI => :NEW.DTINI, P_DTFIN => :NEW.DTFIN, P_CODMETA => :NEW.CODMETA, P_CODEMP => :NEW.CODEMP);
        -- Resultado dos Vendedores/Produtos
        JS_STP_CALC_RES_VEN_PRO (P_DTINI => :NEW.DTINI, P_DTFIN => :NEW.DTFIN, P_CODMETA => :NEW.CODMETA, P_CODEMP => :NEW.CODEMP);

    ELSIF (NVL(:NEW.FATGERALMETA, 0) != NVL(:OLD.FATGERALMETA, 0)) THEN

        JS_STP_CALC_META_VEN (P_DTINI => :NEW.DTINI, P_DTFIN => :NEW.DTFIN, P_CODMETA => :NEW.CODMETA, P_FATGERAL => :NEW.FATGERAL, P_FATGERALMETA => :NEW.FATGERALMETA, P_CODEMP => :NEW.CODEMP);
        JS_STP_CALC_RES_VEN_PCR (P_DTINI => :NEW.DTINI, P_DTFIN => :NEW.DTFIN, P_CODMETA => :NEW.CODMETA, P_CODEMP => :NEW.CODEMP);
        JS_STP_CALC_RES_VEN_PRO (P_DTINI => :NEW.DTINI, P_DTFIN => :NEW.DTFIN, P_CODMETA => :NEW.CODMETA, P_CODEMP => :NEW.CODEMP);

    END IF;
END;
