CREATE OR REPLACE PROCEDURE JS_STP_UPT_PCR_PRO (
    P_DTINI         IN DATE, 
    P_DTFIN         IN DATE, 
    P_CODEMP        IN INT, 
    P_CODMETA       IN INT,
    P_CODVEND       IN INT, 
    P_FATVEN        IN NUMBER, 
    P_METAVEN       IN NUMBER
) AS
    CSDEC           INT;
    V_SUMFAT        NUMBER;
    -- Tipos e Vetores para Parceiros
    TYPE T_PCR_NRORESPCR    IS TABLE OF AD_TMTFATRTVENPCR.NRORESPCR%TYPE;
    TYPE T_PCR_CODPARC      IS TABLE OF AD_TMTFATRTVENPCR.CODPARC%TYPE;
    TYPE T_PCR_FATESTIPCR   IS TABLE OF AD_TMTFATRTVENPCR.FATESTIPCR%TYPE;
    TYPE T_PCR_AVPCRPERC    IS TABLE OF AD_TMTFATRTVENPCR.AVPCRPERC%TYPE;
    TYPE T_PCR_PTCPCRCRESC  IS TABLE OF AD_TMTFATRTVENPCR.PTCPCRCRESC%TYPE;
    TYPE T_PCR_MOVIMPORT    IS TABLE OF AD_TMTFATRTVENPCR.MOVIMPORTVEN%TYPE;
    TYPE T_PCR_FATPCRSLC    IS TABLE OF AD_TMTFATRTVENPCR.FATPCR%TYPE;
    TYPE T_PCR_NRORESVEN    IS TABLE OF AD_TMTFATRTVEN.NRORESVEN%TYPE;

    V_ARR_PCR_NRORESPCR   T_PCR_NRORESPCR;
    V_ARR_PCR_CODPARC     T_PCR_CODPARC;
    V_ARR_PCR_FATESTI     T_PCR_FATESTIPCR;
    V_ARR_PCR_AVPERC      T_PCR_AVPCRPERC;
    V_ARR_PCR_CRESC       T_PCR_PTCPCRCRESC;
    V_ARR_PCR_MOVIMPORT   T_PCR_MOVIMPORT;
    V_ARR_PCR_FATPCRSLC   T_PCR_FATPCRSLC;
    V_ARR_PCR_RESVEN      T_PCR_NRORESVEN;

    V_ARR_PCR_FATPCR      T_PCR_FATPCRSLC   := T_PCR_FATPCRSLC();
    V_ARR_PCR_PTCPCR      T_PCR_FATPCRSLC   := T_PCR_FATPCRSLC();
    V_ARR_PCR_AVPCR       T_PCR_FATPCRSLC   := T_PCR_FATPCRSLC();
    V_ARR_PCR_PXMETA      T_PCR_FATPCRSLC   := T_PCR_FATPCRSLC();
    V_ARR_PCR_VPERCPCR    T_PCR_FATPCRSLC   := T_PCR_FATPCRSLC();
    -- Tipos e Vetores para produtos
    TYPE T_PRO_NROPROD      IS TABLE OF AD_TMTFATRTVENPRO.NROPROD%TYPE;
    TYPE T_PRO_CODPRODT     IS TABLE OF AD_TMTFATRTVENPRO.CODPRODT%TYPE;
    TYPE T_PRO_FATESTI      IS TABLE OF AD_TMTFATRTVENPRO.FATESTIVENPRO%TYPE;
    TYPE T_PRO_AVPERC       IS TABLE OF AD_TMTFATRTVENPRO.AVVENPROPERC%TYPE;
    TYPE T_PRO_PTCRESC      IS TABLE OF AD_TMTFATRTVENPRO.PTCVENPROCRESC%TYPE;
    TYPE T_PRO_MOVIMPORT    IS TABLE OF AD_TMTFATRTVENPRO.MOVIMPORTVEN%TYPE;
    TYPE T_PRO_FATPROSLC    IS TABLE OF AD_TMTFATRTVENPRO.FATVENPRO%TYPE;
    TYPE T_PRO_NRORESVEN    IS TABLE OF AD_TMTFATRTVEN.NRORESVEN%TYPE;

    V_ARR_PRO_NROPROD     T_PRO_NROPROD;
    V_ARR_PRO_CODPRODT    T_PRO_CODPRODT;
    V_ARR_PRO_FATESTI     T_PRO_FATESTI;
    V_ARR_PRO_AVPERC      T_PRO_AVPERC;
    V_ARR_PRO_CRESC       T_PRO_PTCRESC;
    V_ARR_PRO_MOVIMPORT   T_PRO_MOVIMPORT;
    V_ARR_PRO_FATPROSLC   T_PRO_FATPROSLC;
    V_ARR_PRO_RESVEN      T_PRO_NRORESVEN;

    V_ARR_PRO_FATPRO      T_PRO_FATPROSLC   := T_PRO_FATPROSLC();
    V_ARR_PRO_PTCPRO      T_PRO_FATPROSLC   := T_PRO_FATPROSLC();
    V_ARR_PRO_AVPRO       T_PRO_FATPROSLC   := T_PRO_FATPROSLC();
    V_ARR_PRO_PXMETA      T_PRO_FATPROSLC   := T_PRO_FATPROSLC();
    V_ARR_PRO_VPERCPRO    T_PRO_FATPROSLC   := T_PRO_FATPROSLC();
BEGIN
    IF P_CODMETA IS NULL THEN
        RAISE_APPLICATION_ERROR(-20001,'Erro: Código da meta não identificado');
    END IF;

    CSDEC := NVL(GET_TSIPAR_INTEIRO('CSDEC'), 2);

    -- BLOCO DOS PARCEIROS/VENDEDOR
    SELECT 
        PCR.NRORESPCR, PCR.CODPARC, PCR.FATESTIPCR, PCR.AVPCRPERC, PCR.PTCPCRCRESC, 
        PCR.MOVIMPORTVEN, PCR.FATPCR, VEN.NRORESVEN
    BULK COLLECT INTO 
        V_ARR_PCR_NRORESPCR, V_ARR_PCR_CODPARC, V_ARR_PCR_FATESTI, V_ARR_PCR_AVPERC, V_ARR_PCR_CRESC, 
        V_ARR_PCR_MOVIMPORT, V_ARR_PCR_FATPCRSLC, V_ARR_PCR_RESVEN
    FROM AD_TMTFATRTVENPCR PCR
    JOIN AD_TMTFATRTVEN VEN ON VEN.NRORESVEN = PCR.NRORESVEN
    WHERE PCR.CODMETA = P_CODMETA
      AND VEN.CODVEND = P_CODVEND;

    IF V_ARR_PCR_NRORESPCR.COUNT > 0 THEN 
     
        V_ARR_PCR_FATPCR.EXTEND(V_ARR_PCR_NRORESPCR.COUNT);
        V_ARR_PCR_PTCPCR.EXTEND(V_ARR_PCR_NRORESPCR.COUNT);
        V_ARR_PCR_AVPCR.EXTEND(V_ARR_PCR_NRORESPCR.COUNT);
        V_ARR_PCR_PXMETA.EXTEND(V_ARR_PCR_NRORESPCR.COUNT);
        V_ARR_PCR_VPERCPCR.EXTEND(V_ARR_PCR_NRORESPCR.COUNT);

        FOR y IN 1 .. V_ARR_PCR_NRORESPCR.COUNT LOOP
            -- Validação do faturamento do parceiro
            IF NVL(V_ARR_PCR_MOVIMPORT(y),'N') != 'N' THEN
                V_ARR_PCR_FATPCR(y) := NVL(V_ARR_PCR_FATPCRSLC(y), 0);
            ELSE
                V_ARR_PCR_FATPCR(y) := JS_FC_CALC_FAT(
                                            P_DTINI   => P_DTINI, 
                                            P_DTFIN   => P_DTFIN, 
                                            P_CODVEND => P_CODVEND, 
                                            P_CODPARC => V_ARR_PCR_CODPARC(y),
                                            P_CODEMP  => P_CODEMP
                                       );
            END IF;
            
            V_SUMFAT             := V_ARR_PCR_FATPCR(y) + NVL(V_ARR_PCR_FATESTI(y), 0);
            V_ARR_PCR_PTCPCR(y)  := ROUND(NVL((V_ARR_PCR_FATPCR(y) / NULLIF(P_FATVEN, 0)) * 100, 0), CSDEC);
            V_ARR_PCR_AVPCR(y)   := NVL(V_SUMFAT, 0) * (NVL(V_ARR_PCR_AVPERC(y), 0) / 100);
            V_ARR_PCR_PXMETA(y)  := ROUND(NVL(P_METAVEN, 0) * (V_ARR_PCR_PTCPCR(y) / 100) + NVL(V_ARR_PCR_FATESTI(y), 0) * (1 + NVL(V_ARR_PCR_CRESC(y), 0) / 100), CSDEC);
            V_ARR_PCR_VPERCPCR(y):= ROUND(NVL((V_ARR_PCR_PXMETA(y) - V_SUMFAT) / NULLIF(V_SUMFAT, 0) * 100, 0), CSDEC);
        END LOOP;
        --Reduz a troca de contexto entre o PLS/SQL e o SQL (Fonte-Oracle)
        FORALL y IN 1 .. V_ARR_PCR_NRORESPCR.COUNT
            UPDATE AD_TMTFATRTVENPCR SET
                FATPCR   = V_ARR_PCR_FATPCR(y),
                PTCPCR   = V_ARR_PCR_PTCPCR(y),
                AVPCR    = V_ARR_PCR_AVPCR(y),
                PXMETA   = V_ARR_PCR_PXMETA(y),
                VPERCPCR = V_ARR_PCR_VPERCPCR(y)
            WHERE CODMETA   = P_CODMETA
              AND NRORESVEN = V_ARR_PCR_RESVEN(y)
              AND NRORESPCR = V_ARR_PCR_NRORESPCR(y);
    END IF;

  -- BLOCO DOS PRODUTOS/VENDEDOR
    SELECT 
        PRO.NROPROD, PRO.CODPRODT, PRO.FATESTIVENPRO, PRO.AVVENPROPERC, PRO.PTCVENPROCRESC, 
        PRO.MOVIMPORTVEN, PRO.FATVENPRO, VEN.NRORESVEN
    BULK COLLECT INTO 
        V_ARR_PRO_NROPROD, V_ARR_PRO_CODPRODT, V_ARR_PRO_FATESTI, V_ARR_PRO_AVPERC, V_ARR_PRO_CRESC, 
        V_ARR_PRO_MOVIMPORT, V_ARR_PRO_FATPROSLC, V_ARR_PRO_RESVEN
    FROM AD_TMTFATRTVENPRO PRO
    JOIN AD_TMTFATRTVEN VEN ON VEN.NRORESVEN = PRO.NRORESVEN
    WHERE PRO.CODMETA = P_CODMETA
      AND VEN.CODVEND = P_CODVEND;

    IF V_ARR_PRO_NROPROD.COUNT > 0 THEN
     
        V_ARR_PRO_FATPRO.EXTEND(V_ARR_PRO_NROPROD.COUNT);
        V_ARR_PRO_PTCPRO.EXTEND(V_ARR_PRO_NROPROD.COUNT);
        V_ARR_PRO_AVPRO.EXTEND(V_ARR_PRO_NROPROD.COUNT);
        V_ARR_PRO_PXMETA.EXTEND(V_ARR_PRO_NROPROD.COUNT);
        V_ARR_PRO_VPERCPRO.EXTEND(V_ARR_PRO_NROPROD.COUNT);

        FOR y IN 1 .. V_ARR_PRO_NROPROD.COUNT LOOP
        
            IF NVL(V_ARR_PRO_MOVIMPORT(y),'N') != 'N' THEN 
                V_ARR_PRO_FATPRO(y) := NVL(V_ARR_PRO_FATPROSLC(y), 0);
            ELSE
                V_ARR_PRO_FATPRO(y) := JS_FC_CALC_FAT(
                                            P_DTINI   => P_DTINI, 
                                            P_DTFIN   => P_DTFIN, 
                                            P_CODPROD => V_ARR_PRO_CODPRODT(y), 
                                            P_CODVEND => P_CODVEND, 
                                            P_CODEMP  => P_CODEMP
                                       );
            END IF;

            V_SUMFAT             := V_ARR_PRO_FATPRO(y) + NVL(V_ARR_PRO_FATESTI(y), 0);
            V_ARR_PRO_PTCPRO(y)  := ROUND(NVL((V_ARR_PRO_FATPRO(y) / NULLIF(P_FATVEN, 0)) * 100, 0), CSDEC);
            V_ARR_PRO_AVPRO(y)   := NVL(V_SUMFAT, 0) * (NVL(V_ARR_PRO_AVPERC(y), 0) / 100);
            V_ARR_PRO_PXMETA(y)  := ROUND(NVL(P_METAVEN, 0) * (V_ARR_PRO_PTCPRO(y) / 100) + NVL(V_ARR_PRO_FATESTI(y), 0) * (1 + NVL(V_ARR_PRO_CRESC(y), 0) / 100), CSDEC);
            V_ARR_PRO_VPERCPRO(y):= ROUND(NVL((V_ARR_PRO_PXMETA(y) - V_SUMFAT) / NULLIF(V_SUMFAT, 0) * 100, 0), CSDEC);
        END LOOP;
        --Reduz a troca de contexto entre o PLS/SQL e o SQL (Fonte-Oracle)
        FORALL y IN 1 .. V_ARR_PRO_NROPROD.COUNT
            UPDATE AD_TMTFATRTVENPRO SET
                FATVENPRO   = V_ARR_PRO_FATPRO(y),
                PTCVENPRO   = V_ARR_PRO_PTCPRO(y),
                AVVENPRO    = V_ARR_PRO_AVPRO(y),
                PXMETA      = V_ARR_PRO_PXMETA(y),
                VPERCVENPRO = V_ARR_PRO_VPERCPRO(y)
            WHERE CODMETA   = P_CODMETA
              AND NROPROD   = V_ARR_PRO_NROPROD(y)
              AND NRORESVEN = V_ARR_PRO_RESVEN(y);
    END IF;
EXCEPTION
    WHEN OTHERS THEN
        RAISE_APPLICATION_ERROR(-20001, 'Erro: Não foi possível atualizar os Parceiros e Produtos do vendedor. </br>' || SQLERRM);
END;
