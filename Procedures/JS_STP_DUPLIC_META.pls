CREATE OR REPLACE PROCEDURE JS_STP_DUPLIC_META (
    P_CODUSU NUMBER,        
    P_IDSESSAO VARCHAR2,   
    P_QTDLINHAS NUMBER,     
    P_MENSAGEM OUT VARCHAR2 

) AS 
    PARAM_DTINI     DATE;
    PARAM_DTFIN     DATE;
    PARAM_DTREF     DATE;
    PARAM_CODEMP    NUMBER;
    FIELD_CODMETA   NUMBER;

    V_PROXCODMETA   NUMBER;
    V_CODEMP        NUMBER;
    V_FATGERALANT   AD_TMTFAT.FATGERAL%TYPE;
    V_FATGERALCRESC AD_TMTFAT.FATGERALCRESC%TYPE;
    V_FATGERALMETA  AD_TMTFAT.FATGERALMETA%TYPE;
    V_AVGERAL       AD_TMTFAT.AVGERAL%TYPE;
  
BEGIN
    
    IF P_QTDLINHAS > 1 THEN
        P_MENSAGEM:= '<b>Por questões de performance, é permitido a duplicação de uma meta por vez. Linhas selecionadas:</b> ' || TO_CHAR(P_QTDLINHAS);
        RETURN;
    END IF;

    PARAM_CODEMP:= ACT_INT_PARAM(P_IDSESSAO,'CODEMP');
    PARAM_DTINI:= ACT_DTA_PARAM(P_IDSESSAO,'DTINI');
    PARAM_DTFIN:= ACT_DTA_PARAM(P_IDSESSAO,'DTFIN');
    PARAM_DTREF:= ACT_DTA_PARAM(P_IDSESSAO,'DTREF');

    IF PARAM_CODEMP IS NULL OR PARAM_DTINI IS NULL OR PARAM_DTFIN IS NULL OR PARAM_DTREF IS NULL THEN
        RAISE_APPLICATION_ERROR(-20001,'<b>Preencha todos os dados no formulário de parâmetros.</b>');
    END IF;

    --Verifica se existe ocorrência de registro da empresa
    SELECT COUNT(*) INTO V_CODEMP FROM TSIEMP WHERE CODEMP = PARAM_CODEMP;

    IF V_CODEMP = 0 THEN
        RAISE_APPLICATION_ERROR(-20001,'Erro: <b>Empresa ' || PARAM_CODEMP || ' não existe ou não foi cadastrada.</b>');
    END IF;

    FOR I IN 1..P_QTDLINHAS
    LOOP
    
        FIELD_CODMETA:= ACT_INT_FIELD(P_IDSESSAO,I,'CODMETA');

        IF FIELD_CODMETA IS NULL THEN
            RAISE_APPLICATION_ERROR(-20001,'Erro: <b>A meta selecionada não foi identificada. Certifique-se de que o registro está salvo antes de duplicar.</b>');
        END IF;

        --Bloco anônimo para buscar os dados do Pai
        BEGIN
            SELECT FATGERAL,FATGERALCRESC,FATGERALMETA,AVGERAL
                INTO V_FATGERALANT,V_FATGERALCRESC,V_FATGERALMETA,V_AVGERAL
            FROM AD_TMTFAT
            WHERE CODMETA = FIELD_CODMETA
                AND ROWNUM = 1;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN 
                V_FATGERALANT:= 0;
                V_FATGERALCRESC:= 0;
                V_FATGERALMETA:=0;
                V_AVGERAL:=0;
        END;

        --Gerador de Sequências TGFNUM
        STP_KEYGEN_TGFNUM('AD_TMTFAT',PARAM_CODEMP,'AD_TMTFAT','CODMETA',0,V_PROXCODMETA);

        IF NVL(V_PROXCODMETA, 0) = 0 THEN
            RAISE_APPLICATION_ERROR(-20001, '<b>Erro ao gerar numeração automática via STP_KEYGEN_TGFNUM.</b>');
        END IF;
        
                               --<<<           FAZENDO CÓPIA DOS DADOS         >>>--
            
        --INSTANCIA (MESTRE)
        INSERT INTO AD_TMTFAT (CODMETA,CODEMP,DTINI,DTFIN,DTREF,FATGERAL,FATGERALCRESC,FATGERALMETA,AVGERAL,CODUSU,DHALTER)
        VALUES (V_PROXCODMETA,PARAM_CODEMP,PARAM_DTINI,PARAM_DTFIN,PARAM_DTREF,V_FATGERALANT,V_FATGERALCRESC,V_FATGERALMETA,V_AVGERAL,P_CODUSU,SYSDATE);
        
        --INSTANCIA FILHA (PRODUTOS)
        INSERT INTO AD_TMTFATRTPRO (CODMETA,NRORESPRO,CODPROD,FATPROD,PTCPROD,AVPROD,AVPRODPERC,PTCPRODCRESC,PXMETA, FATESTIPRO, VPERCPROD)
        SELECT V_PROXCODMETA,PRO.NRORESPRO, PRO.CODPROD,PRO.FATPROD,PRO.PTCPROD,PRO.AVPROD,PRO.AVPRODPERC,PRO.PTCPRODCRESC,PRO.PXMETA,PRO.FATESTIPRO,PRO.VPERCPROD  FROM AD_TMTFATRTPRO PRO
        WHERE PRO.CODMETA = FIELD_CODMETA;
        
        --INSTANCIA FILHA (VENDEDORES)
        INSERT INTO AD_TMTFATRTVEN (CODMETA,NRORESVEN,CODVEND,FATVEN,PTCVEN,AVVEN,AVVENPERC,PTCVENCRESC,PXMETA,FATESTIVEN,VPERCVEN)
        SELECT V_PROXCODMETA,VEN.NRORESVEN,VEN.CODVEND,VEN.FATVEN,VEN.PTCVEN,VEN.AVVEN,VEN.AVVENPERC,VEN.PTCVENCRESC,VEN.PXMETA,VEN.FATESTIVEN,VEN.VPERCVEN FROM AD_TMTFATRTVEN VEN
        WHERE VEN.CODMETA = FIELD_CODMETA;
        
        --INSTANCIA FILHA (PARCEIROS DO VENDEDOR)
        INSERT INTO AD_TMTFATRTVENPCR (CODMETA,NRORESVEN,NRORESPCR,CODPARC,PTCPCR,FATPCR,AVPCR,AVPCRPERC,PTCPCRCRESC,PXMETA,FATESTIPCR,VPERCPCR)
        SELECT V_PROXCODMETA,PCR.NRORESVEN,PCR.NRORESPCR,PCR.CODPARC,PCR.PTCPCR,PCR.FATPCR,PCR.AVPCR,PCR.AVPCRPERC,PCR.PTCPCRCRESC,PCR.PXMETA,PCR.FATESTIPCR,PCR.VPERCPCR FROM AD_TMTFATRTVENPCR PCR
        WHERE PCR.CODMETA = FIELD_CODMETA;
        
        --INSTANCIA FILHA (PRODUTOS DO VENDEDOR)
        INSERT INTO AD_TMTFATRTVENPRO (CODMETA,NRORESVEN,NROPROD,CODPRODT,FATVENPRO,PTCVENPRO,AVVENPRO,AVVENPROPERC,PTCVENPROCRESC,PXMETA,FATESTIVENPRO,VPERCVENPRO)
        SELECT V_PROXCODMETA,VENPRO.NRORESVEN,VENPRO.NROPROD,VENPRO.CODPRODT,VENPRO.FATVENPRO,VENPRO.PTCVENPRO,VENPRO.AVVENPRO,VENPRO.AVVENPROPERC,VENPRO.PTCVENPROCRESC,VENPRO.PXMETA,VENPRO.FATESTIVENPRO,VENPRO.VPERCVENPRO FROM AD_TMTFATRTVENPRO VENPRO
        WHERE VENPRO.CODMETA = FIELD_CODMETA;
        
    END LOOP;
  
    P_MENSAGEM := '<b>Meta para empresa '|| PARAM_CODEMP ||' duplicada com Sucesso. Código da Meta:</b> ' || TO_CHAR(V_PROXCODMETA);

EXCEPTION
    WHEN OTHERS THEN
        RAISE_APPLICATION_ERROR(-20001, 'Erro na Rotina <b>[JS_STP_DUPLIC_META]:</b> ' || SQLERRM);
END;

