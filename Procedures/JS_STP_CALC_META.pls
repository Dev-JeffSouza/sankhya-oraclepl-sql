CREATE OR REPLACE PROCEDURE JS_STP_CALC_META (
    P_TIPOEVENTO INT,
    P_IDSESSAO VARCHAR2,
    P_CODUSU INT
) AS

    BEFORE_INSERT INT;
    BEFORE_UPDATE INT;

    V_FATGERALCRESC AD_TMTFAT.FATGERALCRESC%TYPE;
    V_DTINI         AD_TMTFAT.DTINI%TYPE;
    V_DTFIN         AD_TMTFAT.DTFIN%TYPE;

    V_FATGERALANT   AD_TMTFAT.FATGERAL%TYPE;
    V_AVGERAL       AD_TMTFAT.AVGERAL%TYPE;
    V_FATGERALMETA  AD_TMTFAT.FATGERALMETA%TYPE;
    V_AVGERALPERC   AD_TMTFAT.AVGERALPERC%TYPE;  
    V_CODEMP        AD_TMTFAT.CODEMP%TYPE;
BEGIN
    BEFORE_INSERT := 0;
    BEFORE_UPDATE := 4;

    IF P_TIPOEVENTO = BEFORE_INSERT OR P_TIPOEVENTO = BEFORE_UPDATE THEN

        V_FATGERALCRESC := EVP_GET_CAMPO_DEC(P_IDSESSAO,'FATGERALCRESC');
        V_DTINI := EVP_GET_CAMPO_DTA(P_IDSESSAO,'DTINI');
        V_DTFIN := EVP_GET_CAMPO_DTA(P_IDSESSAO,'DTFIN');
        V_AVGERALPERC:= EVP_GET_CAMPO_DEC(P_IDSESSAO,'AVGERALPERC');
        V_CODEMP:= EVP_GET_CAMPO_INT(P_IDSESSAO, 'CODEMP');
        V_AVGERALPERC:= GET_TSIPAR_NUMERO('AVGERALPERC');

        IF V_CODEMP IS NULL THEN
            RAISE_APPLICATION_ERROR(-20001,'Erro: <b>É obrigatório o preenchimento do código da empresa.</b>');
        ELSIF V_DTINI IS NULL OR V_DTFIN IS NULL THEN
            RAISE_APPLICATION_ERROR(-20001,'Erro: <b>É obrigatório o preenchimento do intervalo de datas: DTINI e DTFIN.</b>');
        END IF;

        V_FATGERALANT := JS_FC_CALC_FAT(P_DTINI => V_DTINI,P_DTFIN => V_DTFIN,P_CODEMP => V_CODEMP);
        V_FATGERALMETA := V_FATGERALANT * (1 + NVL(V_FATGERALCRESC,0)/100);
        V_AVGERAL := V_FATGERALMETA * (V_AVGERALPERC/100);
        
        EVP_SET_CAMPO_DEC(P_IDSESSAO,'FATGERAL', V_FATGERALANT);
        EVP_SET_CAMPO_DEC(P_IDSESSAO,'FATGERALMETA', V_FATGERALMETA);
        EVP_SET_CAMPO_DEC(P_IDSESSAO,'AVGERAL', V_AVGERAL);
        EVP_SET_CAMPO_INT(P_IDSESSAO,'CODUSU', P_CODUSU);
       
        IF P_TIPOEVENTO = BEFORE_UPDATE THEN
            EVP_SET_CAMPO_DTA(P_IDSESSAO,'DHALTER',SYSDATE);
        ELSE
            EVP_SET_CAMPO_DTA(P_IDSESSAO,'DTREF',ADD_MONTHS(TRUNC(SYSDATE,'MM'),0));
        END IF;

    END IF;

EXCEPTION
    WHEN OTHERS THEN
        RAISE_APPLICATION_ERROR(-20001, 'Erro na Rotina <b>[JS_STP_CALC_META]: </b>' || SQLERRM);
END;

