create or replace PROCEDURE JS_STP_CALC_RES_VEN_PRO (

    P_TIPOEVENTO INT DEFAULT NULL,
    P_IDSESSAO VARCHAR2 DEFAULT NULL,
    P_CODUSU INT DEFAULT NULL,
  --Parametros de entrada disparados por Trigger e STP de explosão de registros (Padrão nulo, pra não dá erro em eventos)
    P_DTINI           IN DATE DEFAULT NULL,      
    P_DTFIN           IN DATE DEFAULT NULL,  
    P_CODMETA         IN INT DEFAULT NULL,
    P_CODEMP          IN INT DEFAULT NULL
) AS 
    BEFORE_INSERT INT:= 0;
    BEFORE_UPDATE INT:= 4;

    V_CODMETA       AD_TMTFATRTVENPRO.CODMETA%TYPE;
    V_CODPROD       AD_TMTFATRTVENPRO.CODPRODT%TYPE;
    V_FATPRODT      AD_TMTFATRTVENPRO.FATVENPRO%TYPE;
    V_NRORESVEN     AD_TMTFATRTVENPRO.NRORESVEN%TYPE;
    V_PTCPRODT      AD_TMTFATRTVENPRO.PTCVENPRO%TYPE;
    V_AVPRODT       AD_TMTFATRTVENPRO.AVVENPRO%TYPE;
    V_AVPERC        AD_TMTFATRTVENPRO.AVVENPROPERC%TYPE;
    V_PTCPROCRESC   AD_TMTFATRTVENPRO.PTCVENPROCRESC%TYPE;
    V_PXMETA        AD_TMTFATRTVENPRO.PXMETA%TYPE;
    V_FATEST        AD_TMTFATRTVENPRO.FATESTIVENPRO%TYPE;   
    V_VARPERC       AD_TMTFATRTVENPRO.VPERCVENPRO%TYPE;
    V_SUMFAT        NUMBER;

    V_CODVEND       AD_TMTFATRTVEN.CODVEND%TYPE;        
    V_FATVEN        AD_TMTFATRTVEN.FATVEN%TYPE; 
    V_METAVEN       AD_TMTFATRTVEN.PXMETA%TYPE;
    V_DTINI         AD_TMTFAT.DTINI%TYPE;               
    V_DTFIN         AD_TMTFAT.DTFIN%TYPE;                
    V_CODEMP        AD_TMTFAT.CODEMP%TYPE;
    V_IMPORT_MOV    VARCHAR2(1);
    CSDEC           INT;
    V_NEW_META      AD_TMTFATRTVENPRO.PXMETA%TYPE;
BEGIN
    CSDEC:= NVL(GET_TSIPAR_INTEIRO('CSDEC'), 2);
      --Bloco de Cálculo manual
    IF P_TIPOEVENTO = BEFORE_INSERT OR P_TIPOEVENTO = BEFORE_UPDATE THEN

        V_CODMETA:= EVP_GET_CAMPO_INT(P_IDSESSAO,'CODMETA');
        V_CODPROD:= EVP_GET_CAMPO_INT(P_IDSESSAO,'CODPRODT');
        V_NRORESVEN:= EVP_GET_CAMPO_INT(P_IDSESSAO,'NRORESVEN');
        V_AVPERC:= EVP_GET_CAMPO_DEC(P_IDSESSAO,'AVVENPROPERC');
        V_PTCPROCRESC:= EVP_GET_CAMPO_DEC(P_IDSESSAO,'PTCVENPROCRESC');
        V_FATEST:= EVP_GET_CAMPO_DEC(P_IDSESSAO,'FATESTIVENPRO');
        V_FATPRODT:= EVP_GET_CAMPO_DEC(P_IDSESSAO,'FATVENPRO');
        V_IMPORT_MOV:= NVL(EVP_GET_CAMPO_TEXTO(P_IDSESSAO,'MOVIMPORTVEN'),'N');

        IF V_CODMETA IS NULL THEN
            RAISE_APPLICATION_ERROR(-20001,'Erro: <b>Não foi possível identificar o código da Meta.</b>');
        ELSIF V_CODPROD IS NULL THEN
            RAISE_APPLICATION_ERROR(-20001,'Erro: <b>Preencha o código do produto.</b>');
        END IF;

        --Busca os dados da tabela Mestre
        BEGIN
            SELECT DTINI, DTFIN, CODEMP
            INTO V_DTINI, V_DTFIN, V_CODEMP
            FROM AD_TMTFAT
            WHERE CODMETA = V_CODMETA
                AND ROWNUM = 1;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                V_DTINI:= TRUNC(ADD_MONTHS(SYSDATE, -1), 'MM');
                V_DTFIN:= TRUNC(LAST_DAY(ADD_MONTHS(SYSDATE, -1)));
                V_CODEMP:= NVL(GET_TSIPAR_INTEIRO('DEFAULTEMP'), 1);
        END;

        --Captura o CODVEND da tabela pai
        BEGIN
            SELECT CODVEND, FATVEN, PXMETA
            INTO V_CODVEND, V_FATVEN, V_METAVEN
            FROM AD_TMTFATRTVEN 
            WHERE NRORESVEN = V_NRORESVEN
                AND CODMETA = V_CODMETA
                AND ROWNUM = 1;
        EXCEPTION 
            WHEN NO_DATA_FOUND THEN
                RAISE_APPLICATION_ERROR(-20001,'Erro: <b>Vendedor parceiro não encontrado na meta: </b>' || TO_CHAR(V_CODMETA));
        END;

        IF V_IMPORT_MOV != 'N' THEN 
            V_FATPRODT:= NVL(V_FATPRODT, 0);
            V_SUMFAT:= V_FATPRODT + NVL(V_FATEST, 0);
        ELSE
            V_FATPRODT:= JS_FC_CALC_FAT(P_DTINI => V_DTINI,P_DTFIN => V_DTFIN,P_CODPROD => V_CODPROD,P_CODVEND => V_CODVEND,P_CODEMP => V_CODEMP);
            V_SUMFAT:= NVL(V_FATPRODT, 0) + NVL(V_FATEST, 0);
        END IF;

        V_PTCPRODT:= ROUND(NVL((V_FATPRODT / NULLIF(V_FATVEN, 0)) * 100,0), CSDEC);
        V_AVPRODT:= NVL(V_SUMFAT, 0) * (NVL(V_AVPERC, 0) / 100);
        V_PXMETA:= ROUND(NVL(V_METAVEN, 0) * (V_PTCPRODT/100) + NVL(V_FATEST, 0) * (1+ NVL(V_PTCPROCRESC,0) /100), CSDEC);
        V_VARPERC:= ROUND(NVL((V_PXMETA - V_SUMFAT) / NULLIF(V_SUMFAT, 0) *100, 0), CSDEC);

        EVP_SET_CAMPO_DEC(P_IDSESSAO,'FATVENPRO', V_FATPRODT);
        EVP_SET_CAMPO_DEC(P_IDSESSAO,'VPERCVENPRO', V_VARPERC);
        EVP_SET_CAMPO_DEC(P_IDSESSAO,'PTCVENPRO', V_PTCPRODT);
        EVP_SET_CAMPO_DEC(P_IDSESSAO,'AVVENPRO', V_AVPRODT);
        EVP_SET_CAMPO_DEC(P_IDSESSAO,'PXMETA', V_PXMETA);

        IF P_TIPOEVENTO = BEFORE_UPDATE THEN
            SELECT SUM(PXMETA)
            INTO V_NEW_META
            FROM AD_TMTFATRTVENPRO
            WHERE CODMETA = V_CODMETA
                AND NRORESVEN = V_NRORESVEN
                AND CODPRODT != V_CODPROD;

            V_NEW_META:= NVL(V_NEW_META, 0) + NVL(V_PXMETA, 0);

            UPDATE AD_TMTFATRTVEN SET
                PXMETA = V_NEW_META
            WHERE CODMETA = V_CODMETA
                AND NRORESVEN = V_NRORESVEN;
        END IF;

        --Registra usuário,data e hora de alteração (Antes de inserir ou atualizar)
        UPDATE AD_TMTFAT SET 
            DHALTER = SYSDATE, 
            CODUSU = P_CODUSU 
        WHERE CODMETA = V_CODMETA;

    ELSIF P_DTINI IS NOT NULL AND P_DTFIN IS NOT NULL AND P_CODMETA IS NOT NULL THEN
                --<<< Bloco disparado por TRIGGER ou Loop de Polulação de grade >>>--
        V_DTINI:= P_DTINI;
        V_DTFIN:= P_DTFIN;
        V_CODEMP:= P_CODEMP;

        FOR I IN (
            SELECT 
                PRO.NROPROD,
                PRO.CODPRODT, 
                PRO.FATESTIVENPRO,
                PRO.FATVENPRO,
                PRO.MOVIMPORTVEN,
                PRO.AVVENPROPERC, 
                PRO.PTCVENPROCRESC,
                VEN.NRORESVEN,
                VEN.CODVEND,
                VEN.FATVEN,
                VEN.PXMETA
            FROM AD_TMTFATRTVENPRO PRO
            JOIN AD_TMTFATRTVEN VEN ON VEN.NRORESVEN = PRO.NRORESVEN
            WHERE PRO.CODMETA = P_CODMETA
        ) LOOP

            IF NVL(I.MOVIMPORTVEN,'N') != 'N' THEN 
                V_FATPRODT:= NVL(I.FATVENPRO, 0);
            ELSE
                V_FATPRODT:= JS_FC_CALC_FAT(P_DTINI => V_DTINI,P_DTFIN => V_DTFIN,P_CODPROD => I.CODPRODT, P_CODVEND => I.CODVEND, P_CODEMP => V_CODEMP);
            END IF;

            V_SUMFAT:= V_FATPRODT + NVL(I.FATESTIVENPRO, 0);
            V_PTCPRODT:= ROUND(NVL((V_FATPRODT / NULLIF(I.FATVEN, 0)) * 100,0), CSDEC);
            V_AVPRODT:= V_SUMFAT * (NVL(I.AVVENPROPERC, 0) / 100);
            V_PXMETA:= ROUND(NVL(I.PXMETA, 0) * (V_PTCPRODT/100) * (1+ NVL(I.PTCVENPROCRESC,0) /100), CSDEC);
            V_VARPERC:= ROUND(NVL((V_PXMETA - V_SUMFAT) / NULLIF(V_SUMFAT, 0) *100, 0), CSDEC);

            UPDATE AD_TMTFATRTVENPRO SET
                FATVENPRO = V_FATPRODT,
                PTCVENPRO = V_PTCPRODT,
                AVVENPRO  = V_AVPRODT,
                PXMETA    = V_PXMETA,
                VPERCVENPRO = V_VARPERC
            WHERE CODMETA = P_CODMETA
                AND NROPROD = I.NROPROD
                AND NRORESVEN = I.NRORESVEN;
        END LOOP;
    END IF;
EXCEPTION
  WHEN OTHERS THEN
      RAISE_APPLICATION_ERROR(-20001, 'Erro na Rotina <b>[JS_STP_CALC_RES_VEN_PRO]: </b>' || SQLERRM);
END;