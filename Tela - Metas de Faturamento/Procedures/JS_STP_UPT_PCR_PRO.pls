CREATE OR REPLACE PROCEDURE JS_STP_UPT_PCR_PRO (
    P_DTINI         IN DATE, 
    P_DTFIN         IN DATE, 
    P_CODEMP        IN INT, 
    P_CODMETA       IN INT,
    P_CODVEND       IN INT, 
    P_FATVEN        IN NUMBER, 
    P_METAVEN       IN NUMBER
) AS
    V_PTCPCR        AD_TMTFATRTVENPCR.PTCPCR%TYPE;      
    V_FATPCR        AD_TMTFATRTVENPCR.FATPCR%TYPE;      
    V_AVPCR         AD_TMTFATRTVENPCR.AVPCR%TYPE;        
    V_PXMETAPCR     AD_TMTFATRTVENPCR.PXMETA%TYPE;
    V_VARPERC       NUMBER;
    V_SUMFAT        NUMBER;
    V_FATVEN        NUMBER;

    V_FATPRODT      AD_TMTFATRTVENPRO.FATVENPRO%TYPE;
    V_PTCPRODT      AD_TMTFATRTVENPRO.PTCVENPRO%TYPE;
    V_AVPRODT       AD_TMTFATRTVENPRO.AVVENPRO%TYPE;
    V_PXMETAPRO     AD_TMTFATRTVENPRO.PXMETA%TYPE;  
    CSDEC           INT;
BEGIN
    IF P_CODMETA IS NULL THEN
        RAISE_APPLICATION_ERROR(-20001,'Erro: Código da meta não identificado');
    END IF;

    CSDEC:= NVL(GET_TSIPAR_INTEIRO('CSDEC'), 2);
    V_FATVEN:= P_FATVEN;
    --Resultado Parceiro/Vendedor
    FOR I IN (
        SELECT
            PCR.NRORESPCR,
            PCR.CODPARC,
            PCR.FATESTIPCR,
            PCR.FATPCR,
            PCR.AVPCRPERC, 
            PCR.PTCPCRCRESC,
            PCR.MOVIMPORTVEN,
            VEN.CODVEND,
            VEN.NRORESVEN
        FROM AD_TMTFATRTVENPCR PCR
        JOIN AD_TMTFATRTVEN VEN ON VEN.NRORESVEN = PCR.NRORESVEN
        WHERE PCR.CODMETA = P_CODMETA
            AND VEN.CODVEND = P_CODVEND
    ) LOOP

        IF NVL(I.MOVIMPORTVEN,'N') != 'N' THEN
            V_FATPCR:= NVL(I.FATPCR, 0);
        ELSE
            V_FATPCR:= JS_FC_CALC_FAT(P_DTINI => P_DTINI, P_DTFIN => P_DTFIN, P_CODVEND => I.CODVEND, P_CODPARC => I.CODPARC,P_CODEMP => P_CODEMP);
        END IF;
    
        V_SUMFAT:= V_FATPCR + NVL(I.FATESTIPCR,0);
        V_PTCPCR:= ROUND(NVL((V_FATPCR / NULLIF(V_FATVEN, 0)) * 100,0), CSDEC);
        V_AVPCR:= NVL(V_SUMFAT, 0) * (NVL(I.AVPCRPERC, 0) / 100);
        V_PXMETAPCR:= ROUND(NVL(P_METAVEN, 0) * (V_PTCPCR/100) + NVL(I.FATESTIPCR, 0) * (1+ NVL(I.PTCPCRCRESC,0) /100), CSDEC);
        V_VARPERC:= ROUND(NVL((V_PXMETAPCR - V_SUMFAT) / NULLIF(V_SUMFAT, 0) *100, 0), CSDEC);

        -- Atualiza na tabela
        UPDATE AD_TMTFATRTVENPCR SET
            FATPCR = V_FATPCR,
            PTCPCR = V_PTCPCR,
            AVPCR = V_AVPCR,
            PXMETA = V_PXMETAPCR,
            VPERCPCR = V_VARPERC
        WHERE CODMETA = P_CODMETA
            AND NRORESPCR = I.NRORESPCR
            AND NRORESVEN = I.NRORESVEN;
    END LOOP;
    
        -- Resultado Produto/Vendedor
    FOR I IN (
        SELECT 
            PRO.NROPROD,
            PRO.CODPRODT, 
            PRO.FATESTIVENPRO,
            PRO.FATVENPRO,
            PRO.AVVENPROPERC, 
            PRO.PTCVENPROCRESC,
            PRO.MOVIMPORTVEN,
            VEN.CODVEND,
            VEN.NRORESVEN
        FROM AD_TMTFATRTVENPRO PRO
        JOIN AD_TMTFATRTVEN VEN ON VEN.NRORESVEN = PRO.NRORESVEN
        WHERE PRO.CODMETA = P_CODMETA
            AND VEN.CODVEND = P_CODVEND
    ) LOOP

        IF NVL(I.MOVIMPORTVEN,'N') != 'N' THEN
            V_FATPRODT:= NVL(I.FATVENPRO, 0);
        ELSE
            V_FATPRODT:= JS_FC_CALC_FAT(P_DTINI => P_DTINI, P_DTFIN => P_DTFIN, P_CODPROD => I.CODPRODT,P_CODVEND => I.CODVEND, P_CODEMP => P_CODEMP);
        END IF;

        V_SUMFAT:= V_FATPRODT + NVL(I.FATESTIVENPRO, 0);
        V_PTCPRODT:= ROUND(NVL((V_FATPRODT / NULLIF(V_FATVEN, 0)) * 100,0), CSDEC);
        V_AVPRODT:= NVL(V_SUMFAT, 0) * (NVL(I.AVVENPROPERC, 0) / 100);
        V_PXMETAPRO:= ROUND(NVL(P_METAVEN, 0) * (V_PTCPRODT/100) + NVL(I.FATESTIVENPRO, 0) * (1+ NVL(I.PTCVENPROCRESC,0) /100), CSDEC);
        V_VARPERC:= ROUND(NVL((V_PXMETAPRO - V_SUMFAT) / NULLIF(V_SUMFAT, 0) *100, 0), CSDEC);

        UPDATE AD_TMTFATRTVENPRO SET
            FATVENPRO = V_FATPRODT,
            PTCVENPRO = V_PTCPRODT,
            AVVENPRO  = V_AVPRODT,
            PXMETA    = V_PXMETAPRO,
            VPERCVENPRO = V_VARPERC
        WHERE CODMETA = P_CODMETA
            AND NROPROD = I.NROPROD
            AND NRORESVEN = I.NRORESVEN;
    END LOOP;
EXCEPTION
    WHEN OTHERS THEN
        RAISE_APPLICATION_ERROR(-20001, 'Erro: Não foi possível atualizar os Parceiros e Produtos do vendedor. </b>' || SQLERRM);
END;
