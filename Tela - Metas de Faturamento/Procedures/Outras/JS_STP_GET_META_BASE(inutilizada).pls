CREATE OR REPLACE PROCEDURE JS_STP_GET_META_BASE (

  P_CODMETA        IN   AD_TMTFAT.CODMETA%TYPE,
  P_DTINI          OUT  AD_TMTFAT.DTINI%TYPE,
  P_DTFIN          OUT  AD_TMTFAT.DTFIN%TYPE,
  P_FATGERALMETA   OUT  AD_TMTFAT.FATGERALMETA%TYPE,
  P_FATGERALANT    OUT  AD_TMTFAT.FATGERAL%TYPE

)
AS
BEGIN

  IF P_CODMETA IS NULL THEN
    RAISE_APPLICATION_ERROR(-20001, 'ERRO. NÃO FOI POSSÍVEL OBTER O CÓDIGO DA META (PK).');
  END IF;

  SELECT 
    DTINI,
    DTFIN,
    FATGERALMETA,
    FATGERAL
  INTO 
    P_DTINI,
    P_DTFIN,
    P_FATGERALMETA,
    P_FATGERALANT
  FROM AD_TMTFAT
  WHERE CODMETA = P_CODMETA;

EXCEPTION
  WHEN NO_DATA_FOUND THEN
  
    -- CASO NÃO ECONTRE DATAS, PEGA TODO O MÊS ANTERIOR
    P_DTINI := TRUNC(ADD_MONTHS(SYSDATE, -1), 'MM');
    P_DTFIN := TRUNC(LAST_DAY(ADD_MONTHS(SYSDATE, -1)));

    P_FATGERALMETA := 0;
    P_FATGERALANT := 0;

  WHEN OTHERS THEN
    RAISE_APPLICATION_ERROR(-20001, 'ERRO AO BUSCAR META BASE: ' || SQLERRM);
END;

