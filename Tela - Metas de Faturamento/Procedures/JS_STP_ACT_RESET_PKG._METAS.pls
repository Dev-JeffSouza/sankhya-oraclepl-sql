CREATE OR REPLACE PROCEDURE JS_STP_ACT_RESET_PKG (
    P_CODUSU NUMBER,        
    P_IDSESSAO VARCHAR2,  
	P_QTDLINHAS NUMBER, 
    P_MENSAGEM OUT VARCHAR2 
) AS
BEGIN
    PKG_METAS_FATURAMENTO.RESET_PKG;
    /*DBMS_SESSION.RESET_PACKAGE;*/
    P_MENSAGEM:= JS_FC_CARD_SUCESS_HTML5('Sucesso!','O Gerenciador de Dados (PKG_METAS_FATURAMENTO) foi reiniciado com sucesso para esta sessão!');
EXCEPTION
    WHEN OTHERS THEN
        P_MENSAGEM := JS_FC_CARD_ERR_HTML5('Erro: ','Falha ao reiniciar o Gerenciador de Dados: ' || SQLERRM);
END;
