CREATE OR REPLACE PROCEDURE JS_STP_POP_GRADE_MOV (
    P_CODUSU NUMBER,        
    P_IDSESSAO VARCHAR2,   
    P_QTDLINHAS NUMBER,     
    P_MENSAGEM OUT VARCHAR2 
) AS
    V_PARAM_CODEMP      AD_TMTFAT.CODEMP%TYPE;
    V_CODEMP            AD_TMTFAT.CODEMP%TYPE;
    V_CODEMPMETA        AD_TMTFAT.CODEMP%TYPE;
    V_FIELD_CODMETA     AD_TMTFAT.CODMETA%TYPE;

    V_DTINI             AD_TMTFAT.DTINI%TYPE;
    V_DTFIN             AD_TMTFAT.DTFIN%TYPE;
    V_FATGERALANT       AD_TMTFAT.FATGERAL%TYPE; 
    V_FATGERALMETA      AD_TMTFAT.FATGERALMETA%TYPE;  
    V_PERCAV            NUMBER := 2;
    V_CRESC             NUMBER := 0;
    V_FATEST            NUMBER := 0;
    V_TOPS              VARCHAR(4000);
    V_AFFECTED_ROWS     NUMBER:= 0;
BEGIN

    IF P_QTDLINHAS > 1 THEN
        P_MENSAGEM:= '<b>Por questões de performance, é permitido popular por movimentação uma meta por vez. Linhas selecionadas:</b> ' || TO_CHAR(P_QTDLINHAS);
        RETURN;
    END IF;

    V_PARAM_CODEMP:= ACT_INT_PARAM(P_IDSESSAO,'CODEMP');
    V_FIELD_CODMETA := ACT_INT_FIELD(P_IDSESSAO, 1, 'CODMETA');

    IF V_FIELD_CODMETA IS NULL THEN
        RAISE_APPLICATION_ERROR(-20001,'Erro: <b>A meta selecionada não foi identificada.</b>');
    ELSIF V_PARAM_CODEMP IS NULL THEN
        RAISE_APPLICATION_ERROR(-20001,'Erro: <b>Preencha o código da Empresa.</b>');
    END IF;

    PKG_METAS_FATURAMENTO.RESET_PKG;
    
    BEGIN
        SELECT CODEMP, DTINI, DTFIN, FATGERAL, FATGERALMETA
        INTO V_CODEMPMETA, V_DTINI, V_DTFIN, V_FATGERALANT, V_FATGERALMETA
        FROM AD_TMTFAT 
        WHERE CODMETA = V_FIELD_CODMETA 
            AND ROWNUM = 1;
    EXCEPTION 
        WHEN NO_DATA_FOUND THEN 
            V_CODEMPMETA:= V_PARAM_CODEMP;
            V_DTINI:= TRUNC(ADD_MONTHS(SYSDATE, -1), 'MM');
            V_DTFIN:= TRUNC(LAST_DAY(ADD_MONTHS(SYSDATE, -1)));
    END;

    PKG_METAS_FATURAMENTO.VG_READ_PKG:= TRUE;
    PKG_METAS_FATURAMENTO.V_ARR_CAB(V_FIELD_CODMETA).DTINI:= V_DTINI;
    PKG_METAS_FATURAMENTO.V_ARR_CAB(V_FIELD_CODMETA).DTFIN:= V_DTFIN;
    PKG_METAS_FATURAMENTO.V_ARR_CAB(V_FIELD_CODMETA).CODEMP:= V_CODEMPMETA;
    PKG_METAS_FATURAMENTO.V_ARR_CAB(V_FIELD_CODMETA).FATGERALMETA:= V_FATGERALMETA;
    PKG_METAS_FATURAMENTO.V_ARR_CAB(V_FIELD_CODMETA).FATGERAL:= V_FATGERALANT;

    --Verifica se existe ocorrência de registro da empresa
    SELECT COUNT(*) INTO V_CODEMP FROM TSIEMP WHERE CODEMP = V_PARAM_CODEMP;

    --Validações da empresa
    IF V_CODEMP = 0 THEN
        RAISE_APPLICATION_ERROR(-20001,'Erro: <b>Empresa ' || TO_CHAR(V_PARAM_CODEMP) || ' não existe ou não foi cadastrada.</b>');
    ELSIF V_CODEMPMETA <> V_PARAM_CODEMP THEN
        RAISE_APPLICATION_ERROR(-20001,'Erro: <b>A Empresa informada diverge da cadastrada na meta.</b>');
    END IF;

    -- Deleção 
    DELETE FROM AD_TMTFATRTVENPCR WHERE CODMETA = V_FIELD_CODMETA;
    DELETE FROM AD_TMTFATRTVENPRO WHERE CODMETA = V_FIELD_CODMETA;
    DELETE FROM AD_TMTFATRTVEN WHERE CODMETA = V_FIELD_CODMETA;
    DELETE FROM AD_TMTFATRTPRO WHERE CODMETA = V_FIELD_CODMETA;

    V_TOPS:= ';' || REPLACE(GET_TSIPAR_TEXTO('TOPSCALCFAT'), ' ', '') || ';';

    --PRODUTOS 
    INSERT INTO AD_TMTFATRTPRO (CODMETA, NRORESPRO, CODPROD, AVPRODPERC, PTCPRODCRESC, FATESTIPRO)
    SELECT V_FIELD_CODMETA, JS_SEQ.NEXTVAL, X.CODPROD, V_PERCAV, V_CRESC, V_FATEST
    FROM (
        SELECT I.CODPROD
        FROM TGFITE I
        JOIN TGFCAB C ON C.NUNOTA = I.NUNOTA
        JOIN TGFPRO P ON P.CODPROD = I.CODPROD
        WHERE C.DTMOV BETWEEN V_DTINI AND V_DTFIN
            AND V_TOPS LIKE '%;' || TO_CHAR(C.CODTIPOPER) || ';%'
            AND C.TIPMOV IN ('V','D') 
            AND C.STATUSNOTA = 'L'
            AND C.CODEMP = V_CODEMPMETA
            AND P.USOPROD IN ('V','R')
        GROUP BY 
            I.CODPROD
        ORDER BY 
            I.CODPROD
    ) X;

    V_AFFECTED_ROWS:= V_AFFECTED_ROWS + SQL%ROWCOUNT;

    -- VENDEDORES
    INSERT INTO AD_TMTFATRTVEN (CODMETA, NRORESVEN, CODVEND, AVVENPERC, PTCVENCRESC, FATESTIVEN)
    SELECT V_FIELD_CODMETA, JS_SEQ.NEXTVAL, X.CODVEND, V_PERCAV, V_CRESC, V_FATEST
    FROM (
        SELECT C.CODVEND
        FROM TGFCAB C
        WHERE C.DTMOV BETWEEN V_DTINI AND V_DTFIN
            AND V_TOPS LIKE '%;' || TO_CHAR(C.CODTIPOPER) || ';%'
            AND C.TIPMOV IN ('V','D') 
            AND C.STATUSNOTA = 'L'
            AND C.CODEMP = V_CODEMPMETA
        GROUP BY 
            C.CODVEND
        ORDER BY    
           C.CODVEND 
    ) X;

    V_AFFECTED_ROWS:= V_AFFECTED_ROWS + SQL%ROWCOUNT;

    --PARCEIROS POR VENDEDOR
    INSERT INTO AD_TMTFATRTVENPCR (CODMETA, NRORESVEN, NRORESPCR, CODPARC, AVPCRPERC, PTCPCRCRESC, FATESTIPCR)
    SELECT V_FIELD_CODMETA, X.NRORESVEN, JS_SEQ.NEXTVAL, X.CODPARC, V_PERCAV, V_CRESC, V_FATEST
    FROM (
        SELECT V.NRORESVEN, C.CODPARC
        FROM TGFCAB C
        JOIN AD_TMTFATRTVEN V ON V.CODMETA = V_FIELD_CODMETA AND V.CODVEND = C.CODVEND
        WHERE C.DTMOV BETWEEN V_DTINI AND V_DTFIN
            AND V_TOPS LIKE '%;' || TO_CHAR(C.CODTIPOPER) || ';%'
            AND C.TIPMOV IN ('V','D') 
            AND C.STATUSNOTA = 'L'
            AND C.CODEMP = V_CODEMPMETA
        GROUP BY 
            V.NRORESVEN, C.CODPARC
        ORDER BY 
            C.CODPARC
    ) X;

    V_AFFECTED_ROWS:= V_AFFECTED_ROWS + SQL%ROWCOUNT;

    -- PRODUTOS POR VENDEDOR
    INSERT INTO AD_TMTFATRTVENPRO (CODMETA, NRORESVEN, NROPROD, CODPRODT, AVVENPROPERC, PTCVENPROCRESC, FATESTIVENPRO)
    SELECT V_FIELD_CODMETA, X.NRORESVEN, JS_SEQ.NEXTVAL, X.CODPROD, V_PERCAV, V_CRESC, V_FATEST
    FROM (
        SELECT V.NRORESVEN, I.CODPROD
        FROM TGFITE I
        JOIN TGFCAB C ON C.NUNOTA = I.NUNOTA
        JOIN AD_TMTFATRTVEN V ON V.CODMETA = V_FIELD_CODMETA AND V.CODVEND = C.CODVEND
        WHERE C.DTMOV BETWEEN V_DTINI AND V_DTFIN
            AND V_TOPS LIKE '%;' || TO_CHAR(C.CODTIPOPER) || ';%'
            AND C.TIPMOV IN ('V','D') 
            AND C.STATUSNOTA = 'L'
            AND C.CODEMP = V_CODEMPMETA
        GROUP BY 
            V.NRORESVEN, I.CODPROD
        ORDER BY    
            I.CODPROD
    ) X;

    V_AFFECTED_ROWS:= V_AFFECTED_ROWS + SQL%ROWCOUNT;

    IF NOT V_AFFECTED_ROWS > 0 THEN
        P_MENSAGEM:= JS_FC_CARD_ERR_HTML5('Importação não realizada.','Verique as movimentações nos intervalos de datas selecionados.');
        RETURN;
    END IF;

    P_MENSAGEM := JS_FC_CARD_SUCESS_HTML5('Sucesso!','Grade de Metas gerada com base na movimentação histórica de vendas!');
    PKG_METAS_FATURAMENTO.RESET_PKG;
EXCEPTION
    WHEN OTHERS THEN
        RAISE_APPLICATION_ERROR(-20001,'<b>Erro ao popular grades:</b> ' || SQLERRM);
END;
