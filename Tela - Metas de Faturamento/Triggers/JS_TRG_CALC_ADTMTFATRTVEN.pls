CREATE OR REPLACE TRIGGER JS_TRG_CALC_ADTMTFATRTVEN
BEFORE INSERT OR UPDATE ON AD_TMTFATRTVEN
FOR EACH ROW
DECLARE
    V_DTINI        AD_TMTFAT.DTINI%TYPE;           
    V_DTFIN        AD_TMTFAT.DTFIN%TYPE;           
    V_FATGERALANT  AD_TMTFAT.FATGERAL%TYPE;       
    V_FATGERALMETA AD_TMTFAT.FATGERALMETA%TYPE;  
    V_CODEMP       AD_TMTFAT.CODEMP%TYPE;
    V_PTCVEN       AD_TMTFATRTVEN.PTCVEN%TYPE;
    CSDEC          NUMBER;
    V_SUMFAT       NUMBER;
BEGIN 
    IF :NEW.CODMETA IS NULL THEN 
        RAISE_APPLICATION_ERROR(-20001,'<b>Código da Meta: </b>Código da Meta não identificado.');
    END IF;

    IF :NEW.CODVEND IS NULL THEN 
        RAISE_APPLICATION_ERROR(-20002,'<b>Código do Vendedor: </b>Preencha o Código do Vendedor.');
    END IF;

    CSDEC:= COALESCE(GET_TSIPAR_INTEIRO('CSDEC'), 2);

    IF PKG_METAS_FATURAMENTO.VG_READ_PKG AND PKG_METAS_FATURAMENTO.V_ARR_CAB.EXISTS(:NEW.CODMETA) THEN 
        V_DTINI:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).DTINI;
        V_DTFIN:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).DTFIN;
        V_CODEMP:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).CODEMP;
        V_FATGERALMETA:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).FATGERALMETA;
        V_FATGERALANT:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).FATGERAL;
    ELSE 
        BEGIN
            SELECT DTINI, DTFIN, FATGERALMETA, FATGERAL, CODEMP
            INTO V_DTINI, V_DTFIN, V_FATGERALMETA, V_FATGERALANT, V_CODEMP
            FROM AD_TMTFAT 
            WHERE CODMETA = :NEW.CODMETA;

            PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).DTINI:= V_DTINI;
            PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).DTFIN:= V_DTFIN;
            PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).CODEMP:= V_CODEMP;
            PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).FATGERALMETA:= V_FATGERALMETA;
            PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).FATGERAL:= V_FATGERALANT;
            
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                V_DTINI:= TRUNC(ADD_MONTHS(SYSDATE, -1), 'MM');
                V_DTFIN:= TRUNC(LAST_DAY(ADD_MONTHS(SYSDATE, -1)));
                V_FATGERALMETA:= 0;
                V_FATGERALANT:= 0;
                V_CODEMP:= COALESCE(GET_TSIPAR_INTEIRO('DEFAULTEMP'), 1);
        END;
    END IF;

    IF INSERTING AND COALESCE(:NEW.MOVIMPORTVEN,'N') !='S' OR (:NEW.CODVEND != :OLD.CODVEND) OR PKG_METAS_FATURAMENTO.VG_UPDATING_CAB THEN 
        IF UPDATING AND :NEW.CODVEND != :OLD.CODVEND AND COALESCE(:NEW.MOVIMPORTVEN,'N') != 'N' THEN 
            RAISE_APPLICATION_ERROR(-20003,'Este vendedor possui movimentações financeiras que foram importadas e consolidadas de outro(s) vendedor(es).
                                    Caso precise atualizar o vendedor, você deve excluir a importação atual ou cadastra-lo novamente.');
        END IF;

        :NEW.FATVEN:= JS_FC_CALC_FAT(P_DTINI => V_DTINI, 
                                        P_DTFIN => V_DTFIN, 
                                        P_CODVEND => :NEW.CODVEND, 
                                        P_CODEMP => V_CODEMP);
    ELSE 
        :NEW.FATVEN:= COALESCE(:NEW.FATVEN, 0);
    END IF;

    V_SUMFAT:= COALESCE(:NEW.FATVEN, 0) + COALESCE(:NEW.FATESTIVEN, 0);
    V_PTCVEN:= COALESCE(COALESCE(:NEW.FATVEN, 0) / NULLIF(V_FATGERALANT, 0) * 100, 0);
    :NEW.PTCVEN:= COALESCE(ROUND(V_PTCVEN, CSDEC), 0);
    :NEW.PXMETA:= COALESCE(ROUND(COALESCE(V_FATGERALMETA, 0) * (COALESCE(V_PTCVEN, 0) /100) * (1 + (COALESCE(:NEW.PTCVENCRESC, 0) / 100)) + COALESCE(:NEW.FATESTIVEN, 0), CSDEC), 0);
    :NEW.AVVEN:= COALESCE(:NEW.PXMETA, 0) * (COALESCE(:NEW.AVVENPERC, 0) / 100);
    :NEW.VPERCVEN:= COALESCE(ROUND(COALESCE((:NEW.PXMETA - V_SUMFAT) / NULLIF(V_SUMFAT, 0) * 100, 0), CSDEC), 0);
    :NEW.MOVIMPORTVEN:= COALESCE(:NEW.MOVIMPORTVEN,'N');

    --Grava as informações pros Parceiros e Produtos
    PKG_METAS_FATURAMENTO.V_ARR_VEN (:NEW.NRORESVEN).CODVEND:= :NEW.CODVEND;
    PKG_METAS_FATURAMENTO.V_ARR_VEN (:NEW.NRORESVEN).FATVEN:= :NEW.FATVEN;
    PKG_METAS_FATURAMENTO.V_ARR_VEN (:NEW.NRORESVEN).PXMETA:= :NEW.PXMETA;

    IF UPDATING AND :NEW.NRORESVEN IS NOT NULL THEN
        UPDATE AD_TMTFATRTVENPCR SET NRORESVEN = NRORESVEN 
        WHERE CODMETA = :NEW.CODMETA AND NRORESVEN = :NEW.NRORESVEN;

        UPDATE AD_TMTFATRTVENPRO SET NRORESVEN = NRORESVEN 
        WHERE CODMETA = :NEW.CODMETA AND NRORESVEN = :NEW.NRORESVEN;
    END IF;

    IF UPDATING AND NOT PKG_METAS_FATURAMENTO.VG_READ_PKG THEN
        UPDATE AD_TMTFAT SET 
            DHALTER = SYSDATE,
            CODUSU = TSIUSU_LOG_PKG.V_CODUSULOG
        WHERE CODMETA = :NEW.CODMETA;
    END IF;
EXCEPTION 
    WHEN OTHERS THEN 
        RAISE_APPLICATION_ERROR(-20004, '<b>Erro:</b> Não foi possível calcular o faturamento do Vendedor na meta.' || SQLERRM);
END;
