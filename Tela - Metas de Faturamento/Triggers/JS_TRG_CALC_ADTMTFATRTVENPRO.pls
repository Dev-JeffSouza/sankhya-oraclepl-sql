CREATE OR REPLACE TRIGGER JS_TRG_CALC_ADTMTFATRTVENPRO
BEFORE INSERT OR UPDATE ON AD_TMTFATRTVENPRO
FOR EACH ROW
DECLARE
    V_DTINI     AD_TMTFAT.DTINI%TYPE;           
    V_DTFIN     AD_TMTFAT.DTFIN%TYPE;           
    V_CODEMP    AD_TMTFAT.CODEMP%TYPE;
    V_FATVEN    AD_TMTFATRTVEN.FATVEN%TYPE;
    V_METAVEN   AD_TMTFATRTVEN.PXMETA%TYPE;
    V_CODVEND   AD_TMTFATRTVEN.CODVEND%TYPE;
    V_PTCVENPRO AD_TMTFATRTVENPRO.PTCVENPRO%TYPE;
    CSDEC       NUMBER;
    V_SUMFAT    NUMBER;
BEGIN 
    CSDEC:= COALESCE(GET_TSIPAR_INTEIRO('CSDEC'), 2);

    IF :NEW.NRORESVEN IS NULL THEN 
        RAISE_APPLICATION_ERROR(-20001,'<b>Código de Vinculação: </b>Código de Vinculação Vendedor/Produto não identificado.');
    END IF;

    IF :NEW.CODPRODT IS NULL THEN 
        RAISE_APPLICATION_ERROR(-20002,'Código do Produto: </b>Preencha o Código do Produto.');
    END IF;
    
    --Verifica e busca os valores armazenados na PGA 
    IF PKG_METAS_FATURAMENTO.VG_READ_PKG AND PKG_METAS_FATURAMENTO.V_ARR_CAB.EXISTS(:NEW.CODMETA) THEN 
        V_DTINI:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).DTINI;
        V_DTFIN:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).DTFIN;
        V_CODEMP:= PKG_METAS_FATURAMENTO.V_ARR_CAB(:NEW.CODMETA).CODEMP;
    ELSE
        BEGIN
            SELECT DTINI, DTFIN, CODEMP
                INTO V_DTINI, V_DTFIN, V_CODEMP
            FROM AD_TMTFAT 
            WHERE CODMETA = :NEW.CODMETA;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                V_DTINI:= TRUNC(ADD_MONTHS(SYSDATE, -1), 'MM');
                V_DTFIN:= TRUNC(LAST_DAY(ADD_MONTHS(SYSDATE, -1)));
                V_CODEMP:= COALESCE(GET_TSIPAR_INTEIRO('DEFAULTEMP'), 1);
        END;
    END IF;

    IF PKG_METAS_FATURAMENTO.V_ARR_VEN.EXISTS(:NEW.NRORESVEN) THEN 
        V_CODVEND:= PKG_METAS_FATURAMENTO.V_ARR_VEN(:NEW.NRORESVEN).CODVEND;
        V_FATVEN:= PKG_METAS_FATURAMENTO.V_ARR_VEN(:NEW.NRORESVEN).FATVEN;
        V_METAVEN:= PKG_METAS_FATURAMENTO.V_ARR_VEN(:NEW.NRORESVEN).PXMETA;
    ELSE 
        BEGIN
            SELECT CODVEND, FATVEN, PXMETA
                INTO V_CODVEND, V_FATVEN, V_METAVEN
            FROM AD_TMTFATRTVEN 
            WHERE NRORESVEN = :NEW.NRORESVEN
                AND CODMETA = :NEW.CODMETA
                AND ROWNUM = 1;
        EXCEPTION 
            WHEN NO_DATA_FOUND THEN
                V_CODVEND:= 0;
                V_FATVEN:= 0;
                V_METAVEN:= 0;
        END;
    END IF;

    IF INSERTING AND COALESCE(:NEW.MOVIMPORTVEN,'N') != 'S' OR (:NEW.CODPRODT != :OLD.CODPRODT) OR PKG_METAS_FATURAMENTO.VG_UPDATING_CAB THEN 
        IF UPDATING AND :NEW.CODPRODT != :OLD.CODPRODT AND COALESCE(:NEW.MOVIMPORTVEN,'N') != 'N' THEN 
            RAISE_APPLICATION_ERROR(-20003,'Este Produto possui movimentações financeiras que foram importadas e consolidadas de outro(s) vendedor(es).
                                    Caso precise atualizar o Produto, você deve excluir a importação atual ou cadastra-lo novamente.');
        END IF;

        :NEW.FATVENPRO:= JS_FC_CALC_FAT(P_DTINI => V_DTINI, 
                                        P_DTFIN => V_DTFIN, 
                                        P_CODPROD => :NEW.CODPRODT, 
                                        P_CODVEND => V_CODVEND, 
                                        P_CODEMP  => V_CODEMP);
    ELSE
        :NEW.FATVENPRO:= COALESCE(:NEW.FATVENPRO, 0);
    END IF;

    V_SUMFAT:= COALESCE(:NEW.FATVENPRO, 0) + COALESCE(:NEW.FATESTIVENPRO, 0);
    V_PTCVENPRO:= COALESCE(COALESCE(:NEW.FATVENPRO, 0) / NULLIF(V_FATVEN, 0) * 100, 0);
    :NEW.PTCVENPRO:= COALESCE(ROUND(V_PTCVENPRO, CSDEC), 0);
    :NEW.PXMETA:= COALESCE(ROUND(COALESCE(V_METAVEN, 0) * (COALESCE(V_PTCVENPRO, 0) / 100) * (1 + COALESCE(:NEW.PTCVENPROCRESC, 0) / 100) + COALESCE(:NEW.FATESTIVENPRO, 0), CSDEC), 0);
    :NEW.AVVENPRO:= COALESCE(:NEW.PXMETA, 0) * (COALESCE(:NEW.AVVENPROPERC, 0) / 100);
    :NEW.VPERCVENPRO:= COALESCE(ROUND(COALESCE((:NEW.PXMETA - V_SUMFAT) / NULLIF(V_SUMFAT, 0) * 100, 0), CSDEC), 0);
    :NEW.MOVIMPORTVEN:= COALESCE(:NEW.MOVIMPORTVEN,'N');

    IF UPDATING AND NOT PKG_METAS_FATURAMENTO.VG_READ_PKG THEN
        UPDATE AD_TMTFAT SET 
            DHALTER = SYSDATE,
            CODUSU = TSIUSU_LOG_PKG.V_CODUSULOG
        WHERE CODMETA = :NEW.CODMETA;
    END IF;
EXCEPTION 
    WHEN OTHERS THEN 
        RAISE_APPLICATION_ERROR(-20003,'<b>Erro:</b> Não foi possível calcular o faturamento do Produto na meta.' || SQLERRM);
END;