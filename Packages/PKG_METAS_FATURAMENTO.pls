CREATE OR REPLACE PACKAGE PKG_METAS_FATURAMENTO IS 

    VG_READ_PKG     BOOLEAN:= FALSE;
    VG_UPDATING_CAB BOOLEAN:= FALSE;

    --Estrutura e Tabela para o CABEÇALHO (Indexada por CODMETA)
    TYPE R_CAB IS RECORD (
        DTINI           AD_TMTFAT.DTINI%TYPE,
        DTFIN           AD_TMTFAT.DTFIN%TYPE,
        FATGERAL        AD_TMTFAT.FATGERAL%TYPE,
        FATGERALMETA    AD_TMTFAT.FATGERALMETA%TYPE,
        CODEMP          AD_TMTFAT.CODEMP%TYPE
    );
    TYPE T_CAB IS TABLE OF R_CAB INDEX BY PLS_INTEGER;
    V_ARR_CAB T_CAB; --Chave: CODMETA

    --Estrutura e Tabela para o VENDEDOR (Indexada por NRORESVEN)
    TYPE R_VEN IS RECORD (
        CODVEND         AD_TMTFATRTVEN.CODVEND%TYPE,
        FATVEN          AD_TMTFATRTVEN.FATVEN%TYPE,
        FATVENIMPORT    AD_TMTFATRTVEN.FATVEN%TYPE,
        PXMETA          AD_TMTFATRTVEN.PXMETA%TYPE,
        CODMETA         AD_TMTFATRTVEN.CODMETA%TYPE,
        MOVIMPORTVEN    AD_TMTFATRTVEN.MOVIMPORTVEN%TYPE,
        FATESTIVEN      AD_TMTFATRTVEN.FATESTIVEN%TYPE
    );
    TYPE T_VEN IS TABLE OF R_VEN INDEX BY PLS_INTEGER;
    V_ARR_VEN T_VEN; --Chave: NRORESVEN

    --PROCEDIMENTOS PÚBLICOS

    PROCEDURE RESET_PKG;
END;

CREATE OR REPLACE PACKAGE BODY PKG_METAS_FATURAMENTO IS

    PROCEDURE RESET_PKG IS
    BEGIN
        VG_READ_PKG:= FALSE;
        VG_UPDATING_CAB:= FALSE;
        V_ARR_CAB.DELETE;
        V_ARR_VEN.DELETE;
    END;

END;

--Recompila a Package (Header e Body)
ALTER PACKAGE CENTERMASSASTST.PKG_METAS_FATURAMENTO COMPILE SPECIFICATION;
ALTER PACKAGE CENTERMASSASTST.PKG_METAS_FATURAMENTO COMPILE BODY;

--Limpa a sessão
EXEC DBMS_SESSION.RESET_PACKAGE;

--Localizar quem depende da package
SELECT owner, name, type 
FROM all_dependencies 
WHERE referenced_name = 'NOME_DA_PACKAGE' 
  AND referenced_type = 'PACKAGE';
